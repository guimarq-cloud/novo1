# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: porta do servidor (padrão 3000)
# PORT=3000

# Opcional: modelo (padrão claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Hospedagem com senha de acesso (obrigatória ao publicar na internet)
# APP_PASSWORD=uma-senha-forte

# Modo 100% nacional: gera a anamnese num modelo local via Ollama,
# sem enviar dados para fora do servidor (ver DEPLOY-BRASIL.md)
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Domínio público (usado pelo Caddy no docker-compose)
# DOMINIO=anamnese.suaclinica.com.br
