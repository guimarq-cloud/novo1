{
  "name": "anamnese-medica-app",
  "version": "1.0.0",
  "description": "Especialista em Documentação Médica: grava a consulta, transcreve e estrutura a anamnese formal",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "npm run vendor && tsx watch src/server.ts",
    "vendor": "node scripts/copy-vendor.mjs",
    "build": "npm run vendor && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "onnxruntime-web": "^1.26.0-dev.20260416-b7804b056c",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "br.com.guimarq.anamnese",
    "productName": "Anamnese Médica",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "public/**"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O aplicativo usa o microfone para gravar a consulta e transcrevê-la."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": "always",
      "shortcutName": "Anamnese Médica",
      "artifactName": "AnamneseMedica-Setup-${version}.${ext}"
    }
  }
}
